
-- DBMS Experiment 7
-- Aim: Identify functional dependencies in a denormalized Sales table and normalize it
-- from UNF to 1NF, 2NF, 3NF and BCNF. Verify lossless join and dependency preservation.

CREATE DATABASE IF NOT EXISTS DBMS_Experiments;
USE DBMS_Experiments;

DROP TABLE IF EXISTS Sales_OrderLine;
DROP TABLE IF EXISTS Sales_Order;
DROP TABLE IF EXISTS Sales_Customer;
DROP TABLE IF EXISTS Sales_Salesperson;
DROP TABLE IF EXISTS Sales_Product;
DROP TABLE IF EXISTS Sales_UNF;

-- UNF / denormalized table
CREATE TABLE Sales_UNF (
    Order_ID INT,
    Order_Date DATE,
    Customer_ID INT,
    Customer_Name VARCHAR(60),
    Customer_City VARCHAR(50),
    Product_ID INT,
    Product_Name VARCHAR(60),
    Unit_Price DECIMAL(10,2),
    Quantity INT,
    Salesperson_ID INT,
    Salesperson_Name VARCHAR(60),
    PRIMARY KEY (Order_ID, Product_ID)
);

